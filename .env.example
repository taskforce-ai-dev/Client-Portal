# Twilio credentials — used server-side to pull live call data
# from the Tree House Chalets subaccount.
#
# Master account SID + auth token (the parent that owns subaccounts).
TWILIO_ACCOUNT_SID=AC********************************
TWILIO_AUTH_TOKEN=********************************

# The subaccount SID for Tree House Chalets.
# Find it in the Twilio console: Account > Manage > Subaccounts.
TWILIO_TREEHOUSE_SUBACCOUNT_SID=AC********************************

# --- Knowledge Base: sync with the Tree House agent's source repo ---
# The KB editor reads and commits knowledge_docs/hotel_info.txt in the agent
# repo via the GitHub Contents API. A fine-grained token with Contents
# read+write on this single repo is enough.
KB_GITHUB_TOKEN=github_pat_********************************
KB_GITHUB_REPO=ChrysFernando/Kavya-Agent-Treehouse
KB_GITHUB_PATH=knowledge_docs/hotel_info.txt
KB_GITHUB_BRANCH=main

# --- Optional: PDF -> markdown conversion (Python / FastAPI in ./kb-service) ---
# Only needed for the "Upload PDF" button. Converted text is appended to the
# KB and committed to the repo above. When unset, PDF upload is disabled but
# text editing still works.
KB_API_URL=http://localhost:8000

# Optional shared secret. If set here it must match KB_API_KEY on the service.
KB_API_KEY=

# --- Admin portal (/admin) bootstrap login ---
# Credentials that sign in to the Sentinel admin console served at /admin.
# Required in production — there is no built-in default. Leave unset in
# production and the env-bootstrap admin login is disabled entirely (DB
# admins created via Invite Admin still work). Non-production environments
# may still fall back to a local-only demo pair when these are unset.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Secret for signing the admin session cookie — use a long random string.
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret

# --- Admin invite emails (Resend) ---
# Sends a login-link email to a new admin when they're invited from
# Admin Users. When unset, invites still create the admin, the email is
# just skipped.
RESEND_API_KEY=re_********************************
# Must be a sender on a domain verified in Resend, or their shared
# onboarding@resend.dev sender while testing.
ADMIN_INVITE_FROM=Sentinel Admin <onboarding@resend.dev>
# Optional: absolute base URL of the admin portal (e.g.
# https://sentinel-admin-xxxx.vercel.app). If unset, the invite link is
# built from the request's own origin instead.
ADMIN_PORTAL_URL=

# --- Client invite / set-password emails (Resend) ---
# Shares RESEND_API_KEY above. Sends a single-use set-password link when an
# admin clicks "Send invite" on a client — never a password. Same action
# re-sends for an admin-triggered password reset.
CLIENT_INVITE_FROM=TaskForce AI Client Portal <onboarding@resend.dev>
# Absolute base URL of the client portal, e.g. https://portal.taskforceai.tech
# Used to build the https://<host>/set-password?token=... link. If unset,
# the invite link is built from the request's own origin instead.
CLIENT_PORTAL_URL=

# --- Database (Neon Postgres) for the admin portal ---
# Create a free DB: Vercel → Storage → Postgres (Neon), or neon.tech.
# Use the POOLED connection string. When unset, the admin dashboard shows
# demo data; when set + seeded, it shows live data.
# After setting: `npx prisma db push` then `node prisma/seed.mjs`.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
