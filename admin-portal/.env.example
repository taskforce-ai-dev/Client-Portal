# --- Admin login (seeded on first boot if no admin exists) ---
ADMIN_EMAIL=admin@taskforceai.tech
ADMIN_PASSWORD=change-me-now

# Secret used to sign admin session cookies. Use a long random string.
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret

# --- Data store ---
# Where the JSON store lives. Defaults to the OS temp dir, which is EPHEMERAL
# on Vercel serverless (resets between deploys/cold starts). For real
# persistence, set DATABASE_URL (Postgres) — the store layer is ready for it.
# ADMIN_DATA_FILE=/data/admin-portal-db.json

# DATABASE_URL=postgresql://user:pass@host:5432/dbname
