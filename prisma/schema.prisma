generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum AgentType {
  sales
  support
  booking
  coldcall
}

enum AgentStatus {
  live
  paused
  idle
}

enum Channel {
  voice
  whatsapp
}

enum KnowledgeBaseType {
  faq
  script
  product_info
  objection_handling
  pricing
}

enum TranscriptSentiment {
  pos
  neu
  neg
}

enum TranscriptSpeaker {
  agent
  user
  system
}

enum NotificationEventType {
  call_completed
  agent_error
  spend_threshold
}

enum TeamRole {
  owner
  admin
  viewer
}

enum WebhookDeliveryStatus {
  pending
  success
  failed
}

enum WorkspaceStatus {
  trial
  active
  suspended
  archived
}

enum AdminRole {
  super_admin
  support
  billing
  read_only
}

enum AnnouncementSeverity {
  info
  warning
  critical
}

enum AnnouncementAudience {
  all
  trial
  active
  suspended
  custom
}

enum SupportTicketStatus {
  open
  pending
  resolved
  closed
}

enum SupportTicketPriority {
  low
  normal
  high
  urgent
}

enum SessionSubject {
  admin
  team
}

enum ServiceHealthStatus {
  operational
  degraded
  outage
  maintenance
}

enum IncidentSeverity {
  minor
  major
  critical
}

enum IncidentStatus {
  ongoing
  monitoring
  resolved
}

model Plan {
  id                    String      @id @default(cuid())
  slug                  String      @unique
  name                  String
  description           String?
  monthlyFeeCents       Int         @default(0)
  includedVoiceMinutes  Int         @default(0)
  includedAiMinutes     Int         @default(0)
  includedMessages      Int         @default(0)
  maxAgents             Int?
  maxKnowledgeDocuments Int?
  isPublic              Boolean     @default(true)
  isDefault             Boolean     @default(false)
  // Template metadata used by Sentinel "Agent Templates" panel.
  templateModel         String?
  templateVoice         String?
  templateChannel       String?
  voiceCostPerMinute    Float?
  aiCostPerMessage      Float?
  callCostPerMinute     Float?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  workspaces            Workspace[]
}

model Workspace {
  id               String                @id @default(cuid())
  name             String
  slug             String                @unique
  contactName      String?
  contactEmail     String?
  contactPhone     String?
  timezone         String
  country          String?
  defaultLanguage  String
  retentionDays    Int?
  status           WorkspaceStatus       @default(active)
  monthlyBudgetCents Int                 @default(0)
  trialEndsAt      DateTime?
  suspendedReason  String?
  planId           String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  plan             Plan?                 @relation(fields: [planId], references: [id], onDelete: SetNull)
  notifications    NotificationRule[]
  teamMembers      TeamMember[]
  billingSnapshots BillingUsageSnapshot[]
  invoices         Invoice[]
  agents           Agent[]
  knowledgeBaseDocuments KnowledgeBaseDocument[]
  calls            Call[]
  transcripts      Transcript[]
  messageEvents    MessageEvent[]
  agentEvents      AgentEvent[]
  webhookEndpoints WebhookEndpoint[]
  apiKeys          ClientApiKey[]
  supportTickets   SupportTicket[]
  announcementTargets AnnouncementTarget[]
}

model NotificationRule {
  id             String                @id @default(cuid())
  workspaceId    String
  eventType      NotificationEventType
  emailEnabled   Boolean               @default(false)
  webhookEnabled Boolean               @default(false)
  workspace      Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, eventType])
}

model TeamMember {
  id           String    @id @default(cuid())
  workspaceId  String
  name         String
  email        String    @unique
  role         TeamRole
  initials     String
  color        String
  passwordHash String?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Agent {
  id                 String                @id @default(cuid())
  workspaceId        String?
  externalId         String?               @unique
  name               String                @unique
  type               AgentType
  avatarShape        String?
  status             AgentStatus           @default(idle)
  personality         String?
  language            String?
  greeting            String?
  rating              Float?
  businessType        String?
  businessDescription String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  workspace          Workspace?            @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  channels           AgentChannel[]
  knowledgeBaseLinks AgentKnowledgeBase[]
  calls              Call[]
  messageEvents      MessageEvent[]
  transcripts        Transcript[]
  events             AgentEvent[]
  kbTarget           AgentKbTarget?
  kbDocument         AgentKbDocument?
}

model AgentChannel {
  id      String  @id @default(cuid())
  agentId String
  channel Channel
  agent   Agent   @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, channel])
}

model KnowledgeBaseDocument {
  id            String               @id @default(cuid())
  workspaceId   String?
  externalId    String?              @unique
  title         String
  type          KnowledgeBaseType
  content       String
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  lastWebhookAt DateTime?
  workspace     Workspace?           @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  tags          KnowledgeBaseTag[]
  agentLinks    AgentKnowledgeBase[]
  events        AgentEvent[]
}

model KnowledgeBaseTag {
  id              String                @id @default(cuid())
  knowledgeBaseId String
  value           String
  knowledgeBase   KnowledgeBaseDocument @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)

  @@unique([knowledgeBaseId, value])
}

model AgentKnowledgeBase {
  id              String                @id @default(cuid())
  agentId         String
  knowledgeBaseId String
  createdAt       DateTime              @default(now())
  agent           Agent                 @relation(fields: [agentId], references: [id], onDelete: Cascade)
  knowledgeBase   KnowledgeBaseDocument @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)

  @@unique([agentId, knowledgeBaseId])
}

model Call {
  id               String      @id @default(cuid())
  workspaceId      String?
  externalId       String?     @unique
  agentId          String
  contact          String
  direction        String?
  status           String
  outcome          String?
  startedAt        DateTime
  endedAt          DateTime?
  durationSec      Int         @default(0)
  responseTimeMs   Int?
  sentimentScore   Float?
  resolution       String?
  followUpRequired Boolean     @default(false)
  metadataJson     String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  workspace        Workspace?  @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  agent            Agent       @relation(fields: [agentId], references: [id], onDelete: Cascade)
  transcript       Transcript? @relation("CallTranscript")
  events           AgentEvent[]

  @@index([agentId, startedAt])
}

model MessageEvent {
  id           String      @id @default(cuid())
  workspaceId  String?
  externalId   String?     @unique
  agentId      String
  transcriptId String?
  direction    String
  status       String
  contact      String
  body         String
  occurredAt   DateTime
  threadId     String?
  metadataJson String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  workspace    Workspace?  @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  agent        Agent       @relation(fields: [agentId], references: [id], onDelete: Cascade)
  transcript   Transcript? @relation(fields: [transcriptId], references: [id], onDelete: SetNull)
  events       AgentEvent[]

  @@index([agentId, occurredAt])
}

model Transcript {
  id               String              @id @default(cuid())
  workspaceId      String?
  externalId       String?             @unique
  agentId          String
  channel          Channel
  contact          String
  callId           String?             @unique
  startedAt        DateTime
  endedAt          DateTime?
  durationSec      Int                 @default(0)
  outcome          String?
  sentiment        TranscriptSentiment @default(neu)
  responseTimeMs   Int?
  sentimentScore   Float?
  resolution       String?
  followUpRequired Boolean             @default(false)
  summary          String?
  rawPayloadJson   String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  workspace        Workspace?          @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  agent            Agent               @relation(fields: [agentId], references: [id], onDelete: Cascade)
  call             Call?               @relation("CallTranscript", fields: [callId], references: [id], onDelete: SetNull)
  entries          TranscriptEntry[]
  chapters         TranscriptChapter[]
  messageEvents    MessageEvent[]
  events           AgentEvent[]

  @@index([agentId, startedAt])
}

model TranscriptChapter {
  id           String     @id @default(cuid())
  transcriptId String
  label        String
  sortOrder    Int
  transcript   Transcript @relation(fields: [transcriptId], references: [id], onDelete: Cascade)

  @@unique([transcriptId, sortOrder])
}

model TranscriptEntry {
  id                String           @id @default(cuid())
  transcriptId      String
  speaker           TranscriptSpeaker
  timestampOffsetSec Int
  text              String
  sortOrder         Int
  transcript        Transcript       @relation(fields: [transcriptId], references: [id], onDelete: Cascade)

  @@unique([transcriptId, sortOrder])
}

model AgentEvent {
  id              String                 @id @default(cuid())
  workspaceId     String?
  eventType       String
  summary         String
  severity        String                 @default("info")
  agentId         String?
  callId          String?
  messageEventId  String?
  transcriptId    String?
  knowledgeBaseId String?
  payloadJson     String?
  occurredAt      DateTime
  processedAt     DateTime               @default(now())
  workspace       Workspace?             @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  agent           Agent?                 @relation(fields: [agentId], references: [id], onDelete: SetNull)
  call            Call?                  @relation(fields: [callId], references: [id], onDelete: SetNull)
  messageEvent    MessageEvent?          @relation(fields: [messageEventId], references: [id], onDelete: SetNull)
  transcript      Transcript?            @relation(fields: [transcriptId], references: [id], onDelete: SetNull)
  knowledgeBase   KnowledgeBaseDocument? @relation(fields: [knowledgeBaseId], references: [id], onDelete: SetNull)
  deliveries      WebhookDelivery[]

  @@index([occurredAt])
}

model BillingUsageSnapshot {
  id                   String    @id @default(cuid())
  workspaceId          String
  periodStart          DateTime
  periodEnd            DateTime
  label                String
  voiceMinutes         Int       @default(0)
  aiMinutes            Int       @default(0)
  callMinutes          Int       @default(0)
  messageCount         Int       @default(0)
  transcriptMinutes    Int       @default(0)
  knowledgeDocumentCount Int     @default(0)
  knowledgeUpdateCount Int       @default(0)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  workspace            Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invoices             Invoice[]

  @@unique([workspaceId, periodStart])
}

model Invoice {
  id              String               @id
  workspaceId     String
  usageSnapshotId String?
  issuedAt        DateTime
  dueAt           DateTime
  amountCents     Int
  status          String
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  workspace       Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  usageSnapshot   BillingUsageSnapshot? @relation(fields: [usageSnapshotId], references: [id], onDelete: SetNull)
}

model WebhookEndpoint {
  id             String               @id @default(cuid())
  workspaceId    String?
  url            String
  secret         String?
  status         String               @default("active")
  description    String?
  lastTestedAt   DateTime?
  lastDeliveryAt DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  workspace      Workspace?           @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  events         WebhookEndpointEvent[]
  deliveries     WebhookDelivery[]
}

model WebhookEndpointEvent {
  id         String          @id @default(cuid())
  endpointId String
  eventType  String
  endpoint   WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@unique([endpointId, eventType])
}

model WebhookDelivery {
  id             String                @id @default(cuid())
  endpointId     String
  agentEventId   String
  eventType      String
  payloadJson    String
  status         WebhookDeliveryStatus @default(pending)
  responseStatus Int?
  responseBody   String?
  attemptedAt    DateTime              @default(now())
  durationMs     Int?
  endpoint       WebhookEndpoint       @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  agentEvent     AgentEvent            @relation(fields: [agentEventId], references: [id], onDelete: Cascade)
}

model DashboardSnapshot {
  key        String   @id
  payloadJson String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model AdminUser {
  id                String          @id @default(cuid())
  email             String          @unique
  name              String
  role              AdminRole       @default(support)
  initials          String
  color             String          @default("#7b61ff")
  isActive          Boolean         @default(true)
  passwordHash      String?
  passwordChangedAt DateTime?
  lastLoginAt       DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  auditEntries      AdminAuditLog[]
}

model AdminAuditLog {
  id          String   @id @default(cuid())
  adminId     String?
  action      String
  targetType  String?
  targetId    String?
  summary     String
  metadataJson String?
  occurredAt  DateTime @default(now())
  admin       AdminUser? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([occurredAt])
}

model Announcement {
  id          String                @id @default(cuid())
  title       String
  body        String
  severity    AnnouncementSeverity  @default(info)
  audience    AnnouncementAudience  @default(all)
  publishedAt DateTime              @default(now())
  expiresAt   DateTime?
  createdById String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  targets     AnnouncementTarget[]
}

model AnnouncementTarget {
  id             String       @id @default(cuid())
  announcementId String
  workspaceId    String
  acknowledgedAt DateTime?
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  workspace      Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([announcementId, workspaceId])
}

model ClientApiKey {
  id           String    @id @default(cuid())
  workspaceId  String
  label        String
  prefix       String
  hashedSecret String
  scopes       String    @default("read,write")
  lastUsedAt   DateTime?
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model SupportTicket {
  id          String                @id @default(cuid())
  workspaceId String
  subject     String
  body        String
  status      SupportTicketStatus   @default(open)
  priority    SupportTicketPriority @default(normal)
  openedBy    String?
  assignedTo  String?
  resolvedAt  DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  workspace   Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  messages    SupportTicketMessage[]

  @@index([workspaceId, status])
}

model SupportTicketMessage {
  id         String        @id @default(cuid())
  ticketId   String
  author     String
  authorRole String        @default("client")
  body       String
  createdAt  DateTime      @default(now())
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}

model Session {
  id          String          @id
  subjectType SessionSubject
  subjectId   String
  workspaceId String?
  expiresAt   DateTime
  createdAt   DateTime        @default(now())
  lastSeenAt  DateTime        @default(now())
  userAgent   String?
  ipAddress   String?

  @@index([subjectType, subjectId])
  @@index([expiresAt])
}

model ServiceStatus {
  id             String              @id @default(cuid())
  name           String              @unique
  status         ServiceHealthStatus @default(operational)
  uptimePercent  Float               @default(100)
  latencyMs      Int                 @default(0)
  lastIncidentAt DateTime?
  sortOrder      Int                 @default(0)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  incidents      Incident[]
}

model Incident {
  id              String           @id @default(cuid())
  serviceId       String?
  occurredAt      DateTime
  severity        IncidentSeverity @default(minor)
  durationMinutes Int?
  status          IncidentStatus   @default(ongoing)
  description     String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  service         ServiceStatus?   @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([occurredAt])
}

// Records MRR movement per month (new business, expansion, contraction, churn).
// Computed by jobs / admin actions; the Sentinel "MRR Movement" panel reads
// this table directly. No fallback synthesized values.
model MrrMovement {
  id          String   @id @default(cuid())
  periodStart DateTime
  kind        String
  amountCents Int
  notes       String?
  createdAt   DateTime @default(now())

  @@unique([periodStart, kind])
  @@index([periodStart])
}

model AgentKbTarget {
  id        String   @id @default(cuid())
  agentId   String   @unique
  baseUrl   String
  secret    String
  filename  String   @default("knowledge.txt")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
}

model AgentKbDocument {
  id           String            @id @default(cuid())
  agentId      String            @unique
  content      String
  businessType String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  agent        Agent             @relation(fields: [agentId], references: [id], onDelete: Cascade)
  snapshots    AgentKbSnapshot[]
}

model AgentKbSnapshot {
  id                String          @id @default(cuid())
  agentKbDocumentId String
  content           String
  reason            String?
  createdAt         DateTime        @default(now())
  agentKbDocument   AgentKbDocument @relation(fields: [agentKbDocumentId], references: [id], onDelete: Cascade)

  @@index([agentKbDocumentId])
}
