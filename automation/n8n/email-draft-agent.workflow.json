            {
              "id": "9a1b2c3d-0012-4c00-8000-000000000012",
              "name": "textForAI",
              "value": "={{ [   \"MAILBOX (sender): \" + ($json.body.mailbox || \"\"),   \"RECIPIENT: \" + ($json.body.recipientName || \"\") + \" <\" + ($json.body.recipientEmail || \"\") + \">\",   \"USER INSTRUCTIONS: \" + ($json.body.instructions || \"\"),   $json.body.threadId ? \"--- REPLYING WITHIN THREAD ---\" : \"--- NEW EMAIL (no thread) ---\",   $json.body.originalEmail ? \"ORIGINAL SUBJECT: \" + ($json.body.originalEmail.subject || \"\") : \"\",   $json.body.originalEmail ? \"ORIGINAL FROM: \" + ($json.body.originalEmail.from || \"\") : \"\",   $json.body.originalEmail ? \"ORIGINAL BODY:\\n\" + ($json.body.originalEmail.body || \"\") : \"\" ].filter(Boolean).join(\"\\n\") }}",
